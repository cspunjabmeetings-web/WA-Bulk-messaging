# Copy this file to ".env" and edit.
HOST=127.0.0.1
PORT=8000

# 1 = test mode: nothing is really sent to WhatsApp (good for first try)
WASENDER_MOCK=0
WASENDER_BASE_URL=https://www.wasenderapi.com

# Default country for numbers written without +code (03001234567 -> +923001234567)
DEFAULT_COUNTRY=PK

# Set a password if the portal runs on a server / is reachable by others
PORTAL_PASSWORD=
SECRET_KEY=change-this-to-a-long-random-string

MAX_UPLOAD_MB=20
